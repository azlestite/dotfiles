# see https://www.chezmoi.io/reference/special-files/chezmoiignore/

{{ if eq .chezmoi.os "windows" }}
# only use on Unix-like systems
.chezmoiscripts/000_unix/
.chezmoiscripts/000_unix/**
.bash_profile
.bashrc
.profile
{{- else }}
# only use on Windows
.chezmoiscripts/300_windows/
.chezmoiscripts/300_windows/**
.wslconfig
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
# only use on Mac OS X
.chezmoiscripts/200_mac/
.chezmoiscripts/200_mac/**
{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
# only use on native Linux
.chezmoiscripts/100_linux/110_native/
.chezmoiscripts/100_linux/110_native/**
{{-   else }}
# only use on WSL
.chezmoiscripts/100_linux/120-wsl.sh
{{-   end }}
{{- else }}
# only use on Linux
.chezmoiscripts/100_linux/
.chezmoiscripts/100_linux/**
{{- end }}

{{- if ne .chezmoi.username "azlest" }}
# only use on my private PC
{{- end }}
